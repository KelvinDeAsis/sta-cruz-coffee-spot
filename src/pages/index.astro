---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import frontPhoto from "../assets/front.jpg";
import storyPhoto from "../assets/our-story-exterior.jpg";
import coffeeConvosPhoto from "../assets/coffee-convos.jpg";
import slowAfternoonsPhoto from "../assets/slow-afternoons.jpg";
import madeWithCarePhoto from "../assets/made-with-care.jpg";
import dapitanNightsPhoto from "../assets/dapitan-nights-coffee.jpg";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteInfo, story } from "../data/site";

const galleryCards = [
  { className: "gallery-card--one", label: "Coffee & convos", photo: coffeeConvosPhoto, alt: "Friends sharing drinks and conversation inside Sta. Cruz Coffee Spot" },
  { className: "gallery-card--two", label: "Slow afternoons", photo: slowAfternoonsPhoto, alt: "Sta. Cruz Coffee Spot storefront with a motorcycle parked outside" },
  { className: "gallery-card--three", label: "Made with care", photo: madeWithCarePhoto, alt: "Latte and bread served on a table at Sta. Cruz Coffee Spot" },
  { className: "gallery-card--four", label: "Dapitan nights", photo: dapitanNightsPhoto, alt: "Coffee and bread on a cafe table at night" },
];
---

<BaseLayout>
  <Header />

  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-heading">
      <div class="hero-grid container">
        <div class="hero-copy">
          <p class="eyebrow">Dapitan’s neighborhood coffee spot</p>
          <h1 id="hero-heading">
            Coffee <span>&</span><br />Convos.
          </h1>
          <p class="hero-description">
            Coffee, matcha, and a place to catch up at 2115 Dapitan St., Sampaloc.
          </p>
          <div class="hero-actions">
            <a class="button" href="/menu/" data-analytics="hero-view-menu">
              View the menu <span aria-hidden="true">↗</span>
            </a>
            <a
              class="text-link"
              href={siteInfo.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="hero-directions"
            >
              Get directions <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-photo">
          <Picture
            src={frontPhoto}
            alt="Front entrance of Sta. Cruz Coffee Spot on Dapitan Street"
            widths={[480, 720, 960, 1200]}
            width={1200}
            sizes="(max-width: 950px) calc(100vw - 48px), (min-width: 1536px) 674px, 44vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="ticker" data-ticker>
        <div class="ticker-track" aria-hidden="true">
          {[0, 1].map(() => (
            <div class="ticker-group">
              {[0, 1, 2].map(() => (
                <>
                  <span>Freshly made</span><i>✦</i><span>Open daily</span><i>✦</i><span>Dapitan, Manila</span><i>✦</i>
                </>
              ))}
            </div>
          ))}
        </div>
        <button class="ticker-toggle" type="button" aria-label="Pause scrolling text" data-ticker-toggle hidden>Pause</button>
      </div>
    </section>

    <section id="story" class="story" aria-labelledby="story-heading">
      <div class="story-grid container">
        <div class="story-photo">
          <Picture
            src={storyPhoto}
            alt="Storefront and entrance of Sta. Cruz Coffee Spot on Dapitan Street"
            widths={[480, 720, 960]}
            width={960}
            sizes="(max-width: 660px) calc(100vw - 28px), (max-width: 950px) 620px, (min-width: 1220px) 480px, 40vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
          />
        </div>

        <div class="story-copy">
          <p class="eyebrow">{story.eyebrow}</p>
          <h2 id="story-heading" class="section-title">{story.heading}</h2>
          <div class="story-text">
            {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a
            class="button button--ghost"
            href={siteInfo.socialLinks[1].href}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="story-instagram"
          >
            Follow our story <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="gallery" aria-labelledby="gallery-heading">
      <div class="container gallery-heading">
        <div>
          <p class="eyebrow">Follow along</p>
          <h2 id="gallery-heading" class="section-title">See what’s happening at Sta. Cruz.</h2>
        </div>
        <a
          class="text-link"
          href={siteInfo.socialLinks[1].href}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="gallery-instagram"
        >
          See us on Instagram <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="container gallery-grid">
        {galleryCards.map((card, index) => (
          <a
            class:list={["gallery-card", card.className]}
            href={siteInfo.socialLinks[1].href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${card.label} — see Sta. Cruz Coffee Spot on Instagram`}
          >
            <Picture
              src={card.photo}
              alt={card.alt}
              widths={[400, 640, 960, 1280]}
              width={960}
              sizes={index === 3
                ? "(max-width: 950px) calc(100vw - 28px), (min-width: 1220px) 725px, 62vw"
                : "(max-width: 720px) calc(100vw - 28px), (max-width: 950px) 48vw, (min-width: 1220px) 440px, 37vw"}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
            />
            <span class="gallery-index" aria-hidden="true">0{index + 1}</span>
            <strong>{card.label}</strong>
          </a>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  const ticker = document.querySelector<HTMLElement>("[data-ticker]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-ticker-toggle]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let paused = false;
  const updateTicker = () => {
    ticker?.classList.toggle("is-running", !paused && !reducedMotion.matches);
    if (toggle) {
      toggle.hidden = reducedMotion.matches;
      toggle.textContent = paused ? "Play" : "Pause";
      toggle.setAttribute("aria-label", `${paused ? "Play" : "Pause"} scrolling text`);
    }
  };
  toggle?.addEventListener("click", () => { paused = !paused; updateTicker(); });
  reducedMotion.addEventListener("change", updateTicker);
  updateTicker();
</script>

<style>
  .hero {
    overflow: hidden;
    background:
      radial-gradient(circle at 10% 24%, rgba(184, 195, 162, 0.35), transparent 26%),
      var(--sage-50);
  }

  .hero-grid {
    display: grid;
    width: min(1488px, calc(100% - var(--wide-gutter) * 2));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(56px, 7.5vw, 140px);
    padding-block: 28px 36px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-top: 34px;
  }

  .hero h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(6rem, 10.2vw, 12rem);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: -0.075em;
  }

  .hero h1 span {
    position: relative;
    top: -0.05em;
    color: var(--terracotta);
    font-style: italic;
    font-weight: 400;
  }

  .hero-description {
    max-width: 670px;
    margin: 48px 0 34px;
    color: var(--espresso-soft);
    font-size: clamp(1.02rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
  }

  .hero-actions .button {
    min-height: 60px;
    padding-inline: 28px;
    font-size: 0.86rem;
  }

  .text-link {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid var(--terracotta);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-photo {
    height: clamp(660px, calc(100svh - 120px), 920px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sage-100);
    box-shadow: var(--shadow);
  }

  .hero-photo :global(img),
  .story-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo :global(img) {
    object-position: center 50%;
  }

  .ticker {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--sage-700);
    color: white;
    white-space: nowrap;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 32s linear infinite;
    animation-play-state: paused;
  }

  .ticker.is-running .ticker-track { animation-play-state: running; }

  .ticker-toggle {
    position: absolute;
    inset: 0 0 0 auto;
    min-width: 64px;
    border: 0;
    border-left: 1px solid var(--sage-300);
    background: var(--sage-900);
    color: white;
    cursor: pointer;
    font-size: 0.8rem;
  }

  .ticker-toggle:focus-visible { outline-offset: -4px; }

  .ticker-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 28px;
    padding: 15px 28px 15px 0;
  }

  .ticker span {
    font-family: var(--display);
    font-size: 1.15rem;
    font-style: italic;
  }

  .ticker i {
    color: var(--sage-300);
    font-style: normal;
  }

  @keyframes ticker {
    to { transform: translateX(-50%); }
  }

  .story {
    padding: clamp(90px, 12vw, 160px) 0;
    background: var(--sage-100);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(350px, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(55px, 9vw, 120px);
  }

  .story-photo {
    overflow: hidden;
    min-height: 610px;
    height: min(740px, 60vw);
    border-radius: var(--radius);
    background: var(--sage-700);
  }

  .story-photo :global(img) {
    object-position: center 45%;
  }

  .story-text {
    max-width: 650px;
    margin: 34px 0 32px;
    color: var(--espresso-soft);
    font-size: 1.08rem;
  }

  .gallery {
    padding: clamp(90px, 12vw, 150px) 0;
  }

  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 52px;
  }

  .gallery-heading .section-title { max-width: 860px; }

  .gallery-grid {
    display: grid;
    min-height: 650px;
    grid-template-columns: 1.15fr 0.85fr 1fr;
    grid-template-rows: 1fr 0.8fr;
    gap: 16px;
  }

  .gallery-card {
    position: relative;
    display: flex;
    min-height: 230px;
    align-items: flex-end;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--sage-900);
    color: white;
    text-decoration: none;
  }

  .gallery-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), transparent 35%, rgba(0, 0, 0, 0.68));
    content: "";
    pointer-events: none;
  }

  .gallery-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .gallery-card:hover :global(img) { transform: scale(1.04); }
  .gallery-card--one :global(img) { object-position: center 50%; }
  .gallery-card--two :global(img) { object-position: center 56%; }
  .gallery-card--three :global(img) { object-position: center 69%; }
  .gallery-card--four :global(img) { object-position: center 55%; }

  .gallery-card strong,
  .gallery-index {
    position: relative;
    z-index: 1;
  }

  .gallery-card strong {
    max-width: 160px;
    font-family: var(--display);
    font-size: 1.55rem;
    line-height: 1;
  }

  .gallery-index {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .gallery-card--one {
    grid-row: 1 / span 2;
  }

  .gallery-card--four { grid-column: 2 / span 2; }

  @media (max-width: 950px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-block: 68px 80px;
    }
    .hero-copy { padding-top: 0; }
    .hero h1 { font-size: clamp(5rem, 14vw, 9rem); }
    .hero-photo { height: 620px; }
    .story-grid { grid-template-columns: 1fr; }
    .story-copy { order: -1; }
    .story-photo { max-width: 620px; width: 100%; height: 620px; min-height: 0; }
    .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(2, minmax(240px, auto)) minmax(280px, auto); }
    .gallery-card--one { grid-row: 1 / span 2; }
    .gallery-card--four { grid-column: 1 / -1; }
  }

  @media (max-width: 720px) {
    .hero-grid { padding-top: 56px; }
    .hero h1 { font-size: clamp(4.8rem, 19vw, 7.4rem); }
    .hero-photo { height: 470px; }
    .gallery-grid { min-height: 0; grid-template-columns: 1fr; grid-template-rows: none; }
    .gallery-card { min-height: 0; }
    .story-photo { height: 520px; }
    .gallery-heading { align-items: flex-start; flex-direction: column; }
    .gallery-card--one { grid-row: auto; aspect-ratio: 3 / 4; }
    .gallery-card--two,
    .gallery-card--three { aspect-ratio: 1 / 1; }
    .gallery-card--four { grid-column: auto; aspect-ratio: 16 / 9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
    .gallery-card :global(img) { transition: none; }
  }
</style>
