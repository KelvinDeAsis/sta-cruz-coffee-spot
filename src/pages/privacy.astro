---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteInfo } from "../data/site";
---

<BaseLayout
  title="Privacy Notice | Sta. Cruz Coffee Spot"
  description="How Sta. Cruz Coffee Spot handles information when you visit our website or contact us."
>
  <Header />

  <main id="main-content">
    <header class="privacy-hero">
      <div class="container">
        <p class="eyebrow">The practical details</p>
        <h1>Privacy Notice </h1>
        <p>This page explains what happens when you browse our site or get in touch with us.</p>
        <span>Last updated: September 24, 2026</span>
      </div>
    </header>

    <div class="container privacy-content">
      <section aria-labelledby="who-we-are">
        <h2 id="who-we-are">Who we are</h2>
        <p>
          This is the website of {siteInfo.name}, at {siteInfo.address}. For questions about this notice or your information,
          email <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a> or call <a href={`tel:${siteInfo.phoneHref}`}>{siteInfo.phoneDisplay}</a>.
        </p>
      </section>

      <section aria-labelledby="website-visits">
        <h2 id="website-visits">When you visit</h2>
        <p>
          You can browse the site without creating an account or entering personal details. There are no booking,
          ordering, or contact forms. Our hosting provider, Cloudflare, processes technical request information,
          such as your IP address and the page requested, to deliver and protect the site.
        </p>
      </section>

      <section aria-labelledby="analytics-cookies">
        <h2 id="analytics-cookies">Analytics and cookies</h2>
        <p>
          The website code does not set cookies or use advertising trackers. If we enable Cloudflare Web Analytics
          when the site is hosted, it will measure aggregate visits and page performance. Cloudflare says this
          service does not use cookies or collect visitors’ personal data. We do not use it to identify you.
        </p>
      </section>

      <section aria-labelledby="contact-links">
        <h2 id="contact-links">Contact and other websites</h2>
        <p>
          If you call or email us, we use the details you provide to respond and handle your inquiry. We keep
          correspondence only as needed for that purpose and ordinary business or legal requirements.
        </p>
        <p>
          Links to Instagram, Facebook, and Google Maps take you to their websites or apps. Their privacy
          practices apply once you leave this site. We do not embed their feeds or maps on our pages.
        </p>
      </section>

      <section aria-labelledby="your-choices">
        <h2 id="your-choices">Your choices</h2>
        <p>
          You can ask what information we hold from a message you sent, request a correction or deletion where
          applicable, or raise a privacy concern by emailing <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>.
          We may need to verify your request before acting on it.
        </p>
      </section>

      <section aria-labelledby="changes">
        <h2 id="changes">Changes to this notice</h2>
        <p>
          We will update this page if the site starts using new forms, cookies, advertising tools, or other ways
          of handling visitor information. The date above shows when this notice was last revised.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .privacy-hero {
    padding: clamp(72px, 9vw, 120px) 0;
    background: var(--sage-100);
  }

  .privacy-hero h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(3.7rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .privacy-hero p:not(.eyebrow) {
    max-width: 660px;
    margin: 24px 0 18px;
    color: var(--espresso-soft);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .privacy-hero span {
    color: var(--espresso-soft);
    font-size: 0.85rem;
  }

  .privacy-content {
    max-width: 920px;
    padding-block: clamp(64px, 8vw, 110px) clamp(100px, 10vw, 150px);
  }

  .privacy-content section {
    padding-block: 30px;
    border-bottom: 1px solid var(--line);
  }

  .privacy-content section:first-child { padding-top: 0; }

  .privacy-content h2 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    line-height: 1.1;
  }

  .privacy-content p {
    max-width: 760px;
    margin: 0 0 14px;
    color: var(--espresso-soft);
    font-size: 1.05rem;
  }

  .privacy-content p:last-child { margin-bottom: 0; }

  .privacy-content a {
    color: var(--sage-700);
    font-weight: 700;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
</style>
